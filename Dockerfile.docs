# syntax=docker/dockerfile:1

FROM oven/bun:1.3.14-alpine AS build
WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY tsconfig.json fibel.config.ts ./
COPY assets ./assets
COPY docs ./docs
COPY plugins ./plugins

RUN bun run docs:typecheck && bun run docs:build

FROM oven/bun:1.3.14-alpine AS production-dependencies
WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

FROM oven/bun:1.3.14-alpine
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000

COPY --from=production-dependencies --chown=bun:bun /app/node_modules ./node_modules
COPY --from=build --chown=bun:bun /app/dist ./dist
COPY --from=build --chown=bun:bun /app/package.json ./package.json
COPY --from=build --chown=bun:bun /app/fibel.config.ts ./fibel.config.ts
COPY --from=build --chown=bun:bun /app/assets ./assets
COPY --from=build --chown=bun:bun /app/docs ./docs
COPY --from=build --chown=bun:bun /app/plugins ./plugins

USER bun
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["bun", "-e", "const response = await fetch(`http://127.0.0.1:${process.env.PORT ?? 3000}/robots.txt`); process.exit(response.ok ? 0 : 1);"]

CMD ["bun", "dist/server.ts"]
